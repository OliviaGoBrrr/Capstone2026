  m_Script: {fileID: 11500000, guid: b40767a4573cec943abcf430dae4c01e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  startDialogue:
  - 'Oh, hello there little robot. I haven''t seen a model like you here in years! '
  - 'What have you got there? A package for a house that is broken down now? '
  - 'Well, you might not be able to deliver that package, but I do know you can help
    me! '
  - 'Are you able to go over to where that tall tree is, and grow some crops for
    us? '
  - 'We''re trying to get off of this island you see, using this boat, but we''ll
    need some food to do it first! '
  playerI: {fileID: 1040316987}
  playerM: {fileID: 1040316982}
  textBox: {fileID: 377904154}
  repeatedDialogue:
  - Will you please go over to that area with the large tree, and collect some food
    for our journey?
  endDialogue:
  - 'Thank you so much for the crops! Now we only need one more thing... [End of
    MVP]'
  completedRepeatDialogue:
  - 'Thank you so much for the crops! Now we only need one more thing... [End of
    MVP]'
  PlayerHasItem: 0
  QuestAchieved: 0
